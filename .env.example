# ===== TradeRadar — salin menjadi .env lalu isi (start.bat melakukannya otomatis) =====
APP_VERSION=dev
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false

# ----- Keamanan (WAJIB diisi) -----
SECRET_KEY=ganti-dengan-teks-acak-minimal-32-karakter
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ----- Database & Redis (internal Docker) -----
POSTGRES_USER=traderadar
POSTGRES_PASSWORD=
POSTGRES_DB=traderadar

# ----- Binance (data publik, TIDAK perlu API key) -----
BINANCE_FAPI=https://fapi.binance.com
BINANCE_FSTREAM=wss://fstream.binance.com
BINANCE_SPOT=https://api.binance.com
BINANCE_SPOT_FALLBACK=https://data-api.binance.vision
BINANCE_SPOT_STREAM=wss://stream.binance.com:9443
BINANCE_TAKER_FEE=0.0005

# ----- OANDA (opsional, harga spot XAU_USD; akun practice gratis) -----
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_REST=https://api-fxpractice.oanda.com
OANDA_STREAM=https://stream-fxpractice.oanda.com

# ----- AI -----
# gemini | claude | template
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Cek nama model aktif di Google AI Studio; nama model sering berganti
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
AI_MAX_RPM=5
AI_MAX_RPD=100
AI_TIMEOUT_SECONDS=30

# ----- Telegram -----
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Pisahkan dengan koma. Dapatkan dari /start ke bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ----- Kalender ekonomi -----
NEWS_PRIMARY_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
FINNHUB_API_KEY=
